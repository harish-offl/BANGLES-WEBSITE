# ---------------------------------------------------------------------------
# Bangles by Beauty — environment template
# Copy to `.env.local` and fill in. Never commit real secrets.
# ---------------------------------------------------------------------------

# Public canonical URL of the deployed site (no trailing slash).
# Example: https://banglesbybeauty.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Supabase
# Found in the Supabase dashboard: Project Settings → API.
# ---------------------------------------------------------------------------
# Project URL, e.g. https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# "anon" public key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# "service_role" secret key — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
# Used for admin writes and storage uploads.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# Admin access
# ---------------------------------------------------------------------------
# Local, database-free admin mode. Development use only; ignored in a
# production build. Requires ALLOW_LOCAL_ADMIN=true + a passphrase.
# ALLOW_LOCAL_ADMIN=true
# ADMIN_LOCAL_PASSPHRASE=

# ---------------------------------------------------------------------------
# On-demand cache revalidation
# Shared secret for POST /api/revalidate (header: x-revalidate-secret).
# When unset the endpoint stays disabled. Generate a long random string.
# ---------------------------------------------------------------------------
# REVALIDATE_SECRET=

# ---------------------------------------------------------------------------
# Razorpay
# Found in the Razorpay Dashboard → Settings → API Keys.
# Generate Test Mode keys first; switch to Live Mode only after testing.
# ---------------------------------------------------------------------------
# Razorpay Key ID — safe to expose to the browser for Checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=
# Razorpay Key Secret — SERVER ONLY. Never prefix with NEXT_PUBLIC_.
RAZORPAY_KEY_SECRET=
# Razorpay webhook secret — SERVER ONLY. Set in the Razorpay webhook dashboard.
RAZORPAY_WEBHOOK_SECRET=
